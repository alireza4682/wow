{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "wow",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "bfc372ae-aa4d-48ba-95c5-25d9ae767c3d","database_name": "wow" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8322b1b85dcc4d9da360226c6a3ffabd" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
